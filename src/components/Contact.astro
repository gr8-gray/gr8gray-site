---
// The teaser form — the site's entire conversion path. Field names, max
// lengths, and enum values are a cross-repo contract with the gr8gray-forms
// Worker, single-sourced in src/lib/teaserContract.ts. Read that file's
// header before changing ANYTHING about the fields.
import {
  BUDGET_VALUES,
  DEADLINE_VALUES,
  DEFAULT_FORMS_ORIGIN,
  TEASER_FIELD_MAX,
  TEASER_PATH,
} from "../lib/teaserContract";
import { SECTION_IDS } from "../data/site";

const formsOrigin = import.meta.env.PUBLIC_FORMS_ORIGIN ?? DEFAULT_FORMS_ORIGIN;
const formEndpoint = `${formsOrigin}${TEASER_PATH}`;
// Fallback is Cloudflare's published always-passes dev sitekey. The real key
// is baked in at `astro build` time from PUBLIC_TURNSTILE_SITE_KEY — rotating
// it requires a site redeploy, not just a secret update.
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA";
// Positional destructuring: order comes from the contract arrays and equals
// the rendered <option> order. Labels below are presentation-only copy.
const [DL_HARD, DL_SOFT, DL_FLEX] = DEADLINE_VALUES;
const [B_LT2K, B_2TO5K, B_5TO10K, B_10TO25K, B_GT25K, B_UNSURE] = BUDGET_VALUES;
---

<section id={SECTION_IDS.contact} class="long">
  <div class="wrap">
    <div class="eyebrow">04<span class="sep">·</span>CONTACT</div>
    <h2>Start a project.</h2>

    <form id="teaser-form" class="form" action={formEndpoint} method="POST">
      <div class="field">
        <label for="name_email">NAME + EMAIL</label>
        <input id="name_email" name="name_email" type="text" required maxlength={TEASER_FIELD_MAX.name_email} placeholder="Eric Gray · eric@example.com" />
      </div>
      <div class="field">
        <label for="one_liner">PROJECT — ONE LINER</label>
        <input id="one_liner" name="one_liner" type="text" required maxlength={TEASER_FIELD_MAX.one_liner} placeholder="What are you building, in one sentence." />
      </div>

      <div class="field full">
        <label for="success_metric">SUCCESS METRIC IN 90 DAYS</label>
        <textarea id="success_metric" name="success_metric" required maxlength={TEASER_FIELD_MAX.success_metric} placeholder="What does the site need to have done by then."></textarea>
      </div>

      <div class="field">
        <label for="deadline">TIMELINE</label>
        <select id="deadline" name="deadline" required>
          <option value="">Choose one</option>
          <option value={DL_HARD}>Hard date</option>
          <option value={DL_SOFT}>Soft target</option>
          <option value={DL_FLEX}>Flexible</option>
        </select>
      </div>

      <div class="field">
        <label for="budget">BUDGET</label>
        <select id="budget" name="budget" required>
          <option value="">Choose one</option>
          <option value={B_LT2K}>&lt; $2.5K</option>
          <option value={B_2TO5K}>$2.5K – $5K</option>
          <option value={B_5TO10K}>$5K – $10K</option>
          <option value={B_10TO25K}>$10K – $25K</option>
          <option value={B_GT25K}>$25K+</option>
          <option value={B_UNSURE}>Not sure</option>
        </select>
      </div>

      <div class="field full">
        <label for="examples">EXAMPLES — SITES YOU LIKE</label>
        <textarea id="examples" name="examples" required maxlength={TEASER_FIELD_MAX.examples} placeholder="Links or names. Anything that shows the tone."></textarea>
      </div>

      <div class="full">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
      </div>

      <div class="submit-row">
        <span class="reply">Available · Reply within 24 hours.</span>
        <button class="btn" type="submit">SUBMIT <span class="arr">→</span></button>
      </div>

      <p id="form-status" class="form-status"></p>
    </form>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById("teaser-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  if (form && status) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.textContent = "SENDING…";
      status.className = "form-status";
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const r = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (r.ok) {
          status.textContent = "RECEIVED · REPLY WITHIN 24 HOURS";
          status.className = "form-status ok";
          form.reset();
        } else {
          const body = await r.text();
          status.textContent = `ERROR ${r.status} · EMAIL ERIC@GR8GRAY.DEV`;
          status.className = "form-status err";
          console.error(body);
        }
      } catch (err) {
        status.textContent = "NETWORK ERROR · EMAIL ERIC@GR8GRAY.DEV";
        status.className = "form-status err";
        console.error(err);
      }
    });
  }
</script>
