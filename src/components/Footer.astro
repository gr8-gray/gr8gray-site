---
import { LOCATION, REVISION, SITE_DOMAIN } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="long site-footer">
  <div class="wrap">
    <div class="footwrap">
      <div class="left">© {year} ERIC GRAY · {LOCATION}</div>
      <div class="right">ASTRO · TAILWIND · CLOUDFLARE PAGES · PLEX · CORMORANT</div>
    </div>
    <div class="endmark">{SITE_DOMAIN.toUpperCase()} · DOC-PORTFOLIO-2026 · REV-{REVISION}</div>
  </div>
</footer>
