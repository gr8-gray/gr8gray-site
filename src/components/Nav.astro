---
// Fixed doc-strip nav. Anchor targets are single-sourced in src/data/site.ts
// (SECTION_IDS) — the other half of each pair is the `<section id>` in the
// matching component. e2e/home.spec.ts walks every anchor.
import { LOCATION, REVISION, SECTION_IDS, SITE_DOMAIN } from "../data/site";
---

<div class="docstrip">
  <div class="l">
    <span><span class="led" aria-hidden="true"></span><a href={`#${SECTION_IDS.hero}`}>DOC: {SITE_DOMAIN.toUpperCase()}</a></span>
    <span>REV: {REVISION}</span>
    <span><a href={`#${SECTION_IDS.work}`}>WORK</a></span>
    <span><a href={`#${SECTION_IDS.pantheon}`}>PRODUCT ENG</a></span>
    <span><a href={`#${SECTION_IDS.how}`}>HOW</a></span>
    <span><a href={`#${SECTION_IDS.contact}`}>CONTACT</a></span>
  </div>
  <div class="r"><span>SOLO PROPRIETOR · {LOCATION}</span></div>
</div>
